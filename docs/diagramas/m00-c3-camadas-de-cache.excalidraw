      "boundElements": [],
      "updated": 1793375443715,
      "link": null,
      "locked": false,
      "text": "Decide as regras.\nEnvia:\n\nCache-Control\n  as regras acima\n\nETag / Last-Modified\n  \"versão\" da resposta,\n  para o 304 (Aula 3)",
      "originalText": "Decide as regras.\nEnvia:\n\nCache-Control\n  as regras acima\n\nETag / Last-Modified\n  \"versão\" da resposta,\n  para o 304 (Aula 3)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
